# Copy this file to .env and fill in your Alpaca PAPER trading keys.
# Generate keys at https://app.alpaca.markets/ (toggle to Paper account, then "API Keys").

APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
APCA_BASE_URL=https://paper-api.alpaca.markets

# Optional — email digests via scripts/notify.py
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# NOTIFY_FROM=you@gmail.com
# NOTIFY_TO=you@gmail.com
